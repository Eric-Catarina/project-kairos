// Local: Assets/Scripts/PlayerVisualController.cs

using UnityEngine;
using DG.Tweening;

/// <summary>
/// Gerencia todas as animações e efeitos visuais procedurais do jogador.
/// Ouve eventos do PlayerMovementController para acionar as animações corretas.
