        if (!string.IsNullOrWhiteSpace(newName))
        {
            PlayerProfile.Instance.UpdateCurrentPlayerName(newName);
        }
        else
        {
            UpdateFieldText(); // Reverte para o nome atual se o campo ficar vazio
        }
    }
